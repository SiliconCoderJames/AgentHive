# ---- 构建输出 ----
build/
build-*/
out/
data/
# 打包暂存目录（cmake --install 的产物，ZIP 与 MSI 都从它取材）
_stage/
_stage-*/

# ---- 发行目录：整体不入库（发行说明与产物经 GitHub Releases 发布）----
# 打包所需的 WiX 源文件在 installer/MiderHive.wxs（入库）；本目录只留本地产物与说明。
release/

# ---- 第三方依赖（FetchContent 缓存，scripts/fetch-deps.ps1 可重建）----
vendor/

# ---- CMake / Qt 生成物 ----
CMakeUserPresets.json
*.user
moc_*.cpp
qrc_*.cpp
*.qrc.depends

# ---- 编译中间产物 / 二进制 ----
*.obj
*.exe
*.pdb
*.ilk
*.lib
*.log

# ---- 编辑器 / IDE ----
.vs/
.vscode/
.idea/
.clion/

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 本地工具状态（不入库）----
.mimosa/
.v2c/
