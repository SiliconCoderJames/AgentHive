#pragma once
// 版本号单一来源：由 CMake 从本模板生成（见 src/core/CMakeLists.txt）。
// 默认取根 CMakeLists 的 project(... VERSION ...)；发布流水线可用
//   -DMIDERHIVE_VERSION=v1.2.3
// 覆盖（CI 从 git tag 取）。界面侧栏、/api/health、安装包属性都读这里，
// 避免"界面显示 v1.0、API 自报 0.1.0、安装包又是另一个版本"的三处不一致。
#define MIDERHIVE_VERSION "@MIDERHIVE_VERSION@"
#define MIDERHIVE_VERSION_NUMERIC "@MIDERHIVE_VERSION_NUMERIC@"
#define MIDERHIVE_VERSION_MAJOR @MIDERHIVE_VERSION_MAJOR@
#define MIDERHIVE_VERSION_MINOR @MIDERHIVE_VERSION_MINOR@
#define MIDERHIVE_VERSION_PATCH @MIDERHIVE_VERSION_PATCH@
