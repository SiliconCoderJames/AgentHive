/* MiderHive 工作台 · 主题 QSS 模板（@token@ 由 ui::th() 运行时替换为当前主题色，
   font-size 由 th() 按基准字号缩放）。默认主题「蜂巢」：夜蓝 + 蜜金。
   设计基线：商业产品级 —— 克制的层级（bg/deep/card/field 四层底色 + 发丝线描边）、
   软选中（半透明强调色）、明确的焦点环与悬停/按压反馈、统一圆角与字阶。 */

* {
    font-family: "Segoe UI Variable Text", "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 13px;
    color: @text@;
    selection-background-color: @accent@;
    selection-color: #ffffff;
}

QWidget { background-color: @bg@; }
QWidget:disabled { color: @muted@; }
QMainWindow, QDialog { background-color: @bg@; }
QLabel { background: transparent; }

/* ---- 卡片容器 ---- */
QGroupBox#card {
    background-color: @card@;
    border: 1px solid @line@;
    border-radius: 12px;
    padding: 18px 20px;
    margin-top: 10px;
    font-weight: 600;
}
QGroupBox#card::title {
    subcontrol-origin: margin;
    left: 16px;
    padding: 0 8px;
    font-size: 13px;
    font-weight: 600;
    color: @brand@;   /* 品牌色卡片标题：蜂巢品牌签名 */
}

/* ---- 输入控件 ---- */
QLineEdit, QComboBox, QSpinBox, QDateEdit, QPlainTextEdit {
    background-color: @field@;
    border: 1px solid @line@;
    border-radius: 8px;
    padding: 7px 12px;
    font-size: 13px;
    selection-background-color: @accent@;
    selection-color: #ffffff;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDateEdit:hover, QPlainTextEdit:hover {
    border: 1px solid @fieldhover@;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDateEdit:focus, QPlainTextEdit:focus {
    border: 1px solid @accent@;
    background-color: @field@;
    outline: 0;
}
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QPlainTextEdit:disabled {
    background-color: @card@;
    color: @muted@;
}
QComboBox { padding-right: 28px; outline: 0; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid @muted@;
    margin-right: 8px;
}
QComboBox::down-arrow:hover { border-top-color: @accenthi@; }
QComboBox QAbstractItemView {
    background-color: @card@;
    border: 1px solid @line@;
    border-radius: 8px;
    padding: 4px;
    outline: 0;
    selection-background-color: @selbg@;
    selection-color: @text@;
}
QComboBox QAbstractItemView::item { padding: 6px 10px; border-radius: 5px; margin: 1px 2px; }

/* ---- 复选框 / 单选 ---- */
QCheckBox, QRadioButton { spacing: 8px; background: transparent; }
QCheckBox::indicator, QRadioButton::indicator { width: 16px; height: 16px; }
QCheckBox::indicator {
    border: 1px solid @line@;
    border-radius: 5px;
    background: @field@;
}
QCheckBox::indicator:hover { border-color: @accenthi@; background: @fieldhover@; }
QCheckBox::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 @accenthi@, stop:1 @accentdeep@);
    border-color: @accent@;
}
QCheckBox::indicator:checked:hover { border-color: @accenthi@; }
QRadioButton::indicator {
    border: 1px solid @line@;
    border-radius: 8px;
    background: @field@;
}
QRadioButton::indicator:hover { border-color: @accenthi@; background: @fieldhover@; }
QRadioButton::indicator:checked { background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5, stop:0.45 @accent@, stop:0.55 @field@); border-color: @accent@; }
QCheckBox:disabled, QRadioButton:disabled { color: @muted@; }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    border-color: @line@;
    background: @card@;
}

/* ---- 菜单 ---- */
QMenu {
    background-color: @card@;
    border: 1px solid @line@;
    border-radius: 10px;
    padding: 6px;
}
QMenu::item { padding: 7px 28px 7px 14px; border-radius: 6px; margin: 1px 2px; }
QMenu::item:selected { background-color: @selbg@; color: @text@; }
QMenu::item:disabled { color: @muted@; }
QMenu::separator { height: 1px; background: @line@; margin: 5px 10px; }

/* ---- 按钮 ---- */
QPushButton {
    background-color: @fieldhover@;
    border: 1px solid @line@;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
}
QPushButton:hover { background-color: @line@; border-color: @muted@; }
QPushButton:pressed { background-color: @card@; }
/* 键盘可达性：焦点态给出明确描边（默认会被深色主题吃掉） */
QPushButton:focus { border: 1px solid @accent@; }
QPushButton#primary {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 @accenthi@, stop:1 @accentdeep@);
    border: 1px solid @accentdeep@;
    color: #ffffff;
    font-weight: 600;
}
QPushButton#primary:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 @accenthi@, stop:1 @accent@);
    border-color: @accent@;
}
QPushButton#primary:pressed { background-color: @accentdeep@; }
QPushButton#primary:disabled {
    background-color: @card@;
    border-color: @line@;
    color: @muted@;
    font-weight: normal;
}
QPushButton#danger {
    background-color: @danger@;
    border: 1px solid @danger@;
    color: #ffffff;
    font-weight: 600;
}
QPushButton#danger:hover {
    background-color: transparent;
    border: 1px solid @danger@;
    color: @danger@;
}
QPushButton#danger:pressed { background-color: @errbg@; color: @danger@; }
/* 禁用态必须比可用态明显更暗：原先两者底色相同，只有文字变灰，用户分不清能不能点 */
QPushButton:disabled {
    background-color: @card@;
    border: 1px solid @line@;
    color: @muted@;
}

/* ---- 表格 / 树 / 列表 ---- */
QTableWidget, QTreeWidget, QListWidget, QListView, QTextBrowser {
    background-color: @field@;
    border: 1px solid @line@;
    border-radius: 10px;
    padding: 8px;
    gridline-color: @line@;
    alternate-background-color: @card@;
    outline: 0;
}
QTableWidget::item, QTreeWidget::item { padding: 7px 6px; border-radius: 4px; }
QTableWidget::item:hover, QTreeWidget::item:hover, QListWidget::item:hover, QListView::item:hover {
    background-color: @fieldhover@;
}
/* 软选中：半透明强调色铺底 + 常规字色（商业产品惯例，避免大色块白字的压迫感） */
QTableWidget::item:selected, QTreeWidget::item:selected, QListWidget::item:selected, QListView::item:selected {
    background-color: @selbg@;
    color: @text@;
}
QListWidget::item, QListView::item { padding: 8px; border-radius: 6px; }
QTreeView::branch { background: transparent; }
QTreeView::branch:hover { background: @fieldhover@; }
QTreeView::branch:selected { background: @selbg@; }

QHeaderView::section {
    background-color: @card@;
    color: @muted@;
    border: none;
    border-bottom: 1px solid @line@;
    padding: 10px 12px;
    font-size: 12px;
    font-weight: 600;
}
QTableCornerButton::section { background-color: @card@; border: none; }

/* ---- 选项卡（设置对话框）---- */
QTabWidget::pane {
    border: 1px solid @line@;
    border-radius: 10px;
    top: -1px;
    background: @bg@;
}
QTabBar::tab {
    background: transparent;
    color: @muted@;
    padding: 10px 22px;
    border: none;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:selected { color: @text@; font-weight: 600; border-bottom: 2px solid @accent@; }
QTabBar::tab:hover:!selected { color: @text@; }

/* ---- 滚动条：细轨 + 圆角滑块，悬停点亮 ---- */
QScrollBar:vertical { background: transparent; width: 10px; margin: 3px 2px; }
QScrollBar::handle:vertical { background: @line@; border-radius: 5px; min-height: 32px; }
QScrollBar::handle:vertical:hover { background: @accenthi@; }
QScrollBar::handle:vertical:pressed { background: @accent@; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px 3px; }
QScrollBar::handle:horizontal { background: @line@; border-radius: 5px; min-width: 32px; }
QScrollBar::handle:horizontal:hover { background: @accenthi@; }
QScrollBar::handle:horizontal:pressed { background: @accent@; }

/* ---- 其它 ---- */
QStatusBar { background-color: @deep@; color: @muted@; border-top: 1px solid @line@; }
QStatusBar QLabel { color: @muted@; font-size: 11px; }
QToolTip {
    background-color: @card@;
    color: @text@;
    border: 1px solid @line@;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}
QSplitter::handle { background-color: @line@; width: 2px; }
QSplitter::handle:hover { background-color: @brand@; }
QProgressBar {
    background-color: @field@;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
}
QProgressBar::chunk {
    border-radius: 4px;
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @accentdeep@, stop:1 @accenthi@);
}
QLabel#muted { color: @muted@; font-size: 11px; }
QLabel#h1 { font-size: 18px; font-weight: 700; color: @text@; }
QLabel#mono { font-family: "@mono@", "Cascadia Mono", Consolas, monospace; }

/* ---- 工具按钮（折叠头等）---- */
QToolButton { background: transparent; border: none; border-radius: 7px; padding: 5px 10px; }
QToolButton:hover { background: @fieldhover@; }
QToolButton:pressed { background: @line@; }
QToolButton:checked { background: @selbg@; color: @accenthi@; }
