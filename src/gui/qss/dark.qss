/* AgentHive 工作台 · 主题 QSS 模板（@token@ 由 ui::th() 运行时替换为当前主题色，
   font-size 由 th() 按基准字号缩放）。默认主题「蜂巢」：夜蓝 + 蜜金。 */

* {
    font-family: "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 12px;
    color: @text@;
    selection-background-color: @accent@;
    selection-color: #ffffff;
}

QWidget { background-color: @bg@; }
QMainWindow, QDialog { background-color: @bg@; }

/* ---- 卡片容器 ---- */
QGroupBox#card {
    background-color: @card@;
    border: 1px solid @line@;
    border-radius: 10px;
    padding: 14px;
    margin-top: 8px;
    font-weight: 600;
}
QGroupBox#card::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: @brand@;   /* 品牌色卡片标题：蜂巢品牌签名 */
}

/* ---- 输入控件 ---- */
QLineEdit, QComboBox, QSpinBox, QDateEdit, QPlainTextEdit {
    background-color: @field@;
    border: 1px solid @line@;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDateEdit:focus, QPlainTextEdit:focus {
    border: 1px solid @accent@;
    background-color: @card@;
    outline: 0;
}
QComboBox { padding-right: 26px; outline: 0; }
QComboBox::drop-down { border: none; width: 20px; }
QComboBox::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid @muted@;
    margin-right: 8px;
}
QComboBox::down-arrow:hover { border-top-color: @accenthi@; }
QComboBox QAbstractItemView {
    background-color: @card@;
    border: 1px solid @line@;
    selection-background-color: @accent@;
}

/* ---- 复选框 / 单选 ---- */
QCheckBox, QRadioButton { spacing: 7px; }
QCheckBox::indicator, QRadioButton::indicator { width: 15px; height: 15px; }
QCheckBox::indicator {
    border: 1px solid @line@;
    border-radius: 4px;
    background: @field@;
}
QCheckBox::indicator:hover { border-color: @accenthi@; }
QCheckBox::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 @accenthi@, stop:1 @accentdeep@);
    border-color: @accent@;
}
QRadioButton::indicator {
    border: 1px solid @line@;
    border-radius: 8px;
    background: @field@;
}
QRadioButton::indicator:hover { border-color: @accenthi@; }
QRadioButton::indicator:checked { background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5, stop:0.45 @accent@, stop:0.55 @field@); border-color: @accent@; }
QCheckBox:disabled, QRadioButton:disabled { color: @muted@; }

/* ---- 菜单 ---- */
QMenu {
    background-color: @card@;
    border: 1px solid @line@;
    border-radius: 8px;
    padding: 5px;
}
QMenu::item { padding: 6px 22px; border-radius: 5px; }
QMenu::item:selected { background-color: @accent@; color: #ffffff; }
QMenu::separator { height: 1px; background: @line@; margin: 4px 8px; }

/* ---- 按钮 ---- */
QPushButton {
    background-color: @fieldhover@;
    border: none;
    border-radius: 6px;
    padding: 7px 16px;
    font-size: 12px;
}
QPushButton:hover { background-color: @line@; }
QPushButton:pressed { background-color: @card@; }
QPushButton#primary {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 @accenthi@, stop:1 @accentdeep@);
    color: #ffffff;
    font-weight: 600;
}
QPushButton#primary:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 @accenthi@, stop:1 @accent@);
}
QPushButton#primary:pressed { background-color: @accentdeep@; }
QPushButton#danger { background-color: @danger@; color: #ffffff; }
QPushButton:disabled { background-color: @fieldhover@; color: @muted@; }

/* ---- 表格 / 树 / 列表 ---- */
QTableWidget, QTreeWidget, QListWidget, QTextBrowser {
    background-color: @field@;
    border: 1px solid @line@;
    border-radius: 8px;
    padding: 6px;
    gridline-color: @line@;
    alternate-background-color: @card@;
}
QHeaderView::section {
    background-color: @card@;
    color: @muted@;
    border: none;
    border-bottom: 1px solid @line@;
    padding: 7px 8px;
    font-size: 11px;
}
QTableWidget::item, QTreeWidget::item { padding: 5px; }
QTableWidget::item:hover, QTreeWidget::item:hover, QListWidget::item:hover {
    background-color: @fieldhover@;
}
QTableWidget::item:selected, QTreeWidget::item:selected, QListWidget::item:selected {
    background-color: @accent@;
    color: #ffffff;
}
QListWidget::item { padding: 7px; border-radius: 5px; }

/* ---- 选项卡（设置对话框）---- */
QTabWidget::pane {
    border: 1px solid @line@;
    border-radius: 8px;
    top: -1px;
    background: @bg@;
}
QTabBar::tab {
    background: transparent;
    color: @muted@;
    padding: 7px 18px;
    border: none;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:selected { color: @text@; border-bottom: 2px solid @accent@; }
QTabBar::tab:hover:!selected { color: @text@; }

/* ---- 滚动条 ---- */
QScrollBar:vertical { background: transparent; width: 9px; margin: 2px; }
QScrollBar::handle:vertical { background: @line@; border-radius: 4px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: @accent@; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar:horizontal { background: transparent; height: 9px; margin: 2px; }
QScrollBar::handle:horizontal { background: @line@; border-radius: 4px; min-width: 30px; }
QScrollBar::handle:horizontal:hover { background: @accent@; }

/* ---- 其它 ---- */
QStatusBar { background-color: @deep@; color: @muted@; border-top: 1px solid @line@; }
QStatusBar QLabel { color: @muted@; font-size: 11px; }
QToolTip {
    background-color: @card@;
    color: @text@;
    border: 1px solid @brand@;
    padding: 5px;
}
QSplitter::handle { background-color: @line@; width: 2px; }
QProgressBar {
    background-color: @field@;
    border: none;
    border-radius: 5px;
    height: 10px;
    text-align: center;
}
QProgressBar::chunk {
    border-radius: 5px;
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @accentdeep@, stop:1 @accenthi@);
}
QLabel#muted { color: @muted@; font-size: 11px; }
QLabel#h1 { font-size: 16px; font-weight: 700; color: @text@; }
QLabel#mono { font-family: "@mono@", monospace; }

/* ---- 工具按钮（折叠头等）---- */
QToolButton { background: transparent; border: none; border-radius: 6px; padding: 4px 8px; }
QToolButton:hover { background: @fieldhover@; }
QToolButton:pressed { background: @line@; }
